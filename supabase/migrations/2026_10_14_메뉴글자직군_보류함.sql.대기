/* ⏸ 아직 안 돌렸습니다 — 세중님 결정을 기다립니다 (2026-10-14)
 *
 * 「사이트 왼쪽 메뉴 글자」로 직군이 정해져 회원 화면에 떠 있는 7건입니다.
 * 본문에 「물리치료」·「작업치료」는 있는데 **「치료사」가 한 번도 없습니다** —
 *   「물리치료센터」(강진 메뉴) · 「물리치료실」(한국병원 진료지원 메뉴) ·
 *   「작업치료학 등의 분야 전공자」(치매센터 연구위원 응시자격)
 *
 * 코드는 이미 고쳤습니다(tools/공고문읽기.mjs 의 본문직군). 새 공고는 이 길로
 * 안 옵니다. 이 7건은 **이미 쌓인 것**이라 안 고쳐집니다 (지침 9절).
 *
 * 「지난 공고」가 아니라 **보류함**입니다 — 강진 5건은 진짜 통합 채용 공고이고
 * 우리 직군이 첨부에 있을 수 있습니다. 버리면 못 되살립니다.
 */
select set_config('app.누가', '세중님 결정 (2026-10-14)', true);
select set_config('app.왜',
  '보류함으로 · 직군을 사이트 메뉴 글자에서 집었습니다 (본문에 「치료사」 없음)', true);

update job_posts set
  hold         = true,
  hidden       = false,
  admin_locked = true,
  admin_at     = now(),
  admin_note   = '직군 미확인 — 본문에 「치료사」가 없습니다 (메뉴 글자에 걸렸습니다)',
  updated_at   = now()
where id in (
  'HS457911835',    -- 강진의료원 제2026-23호 제7차 직원 채용 공고
  'HS1819213990',   -- 강진의료원 제2026-24호 제7차 직원 채용
  'HS1876316898',   -- 강진의료원 제2026-26호 제8차 직원 채용 공고
  'HS1540707103',   -- 강진의료원 제2026-27호 하반기 직원 채용 공고
  'HS82396933',     -- 강진의료원 제2026-18호 제6차 직원 채용 공고
  'HS1340954199',   -- 한국병원 「[모집]심뇌혈관센터 방사선사」  ← 남의 직군입니다
  'ND1724'          -- 서울광역치매센터 「연구위원(계약직)」 (응시자격에 작업치료학)
);
